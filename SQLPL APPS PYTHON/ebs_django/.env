SECRET_KEY=django-insecure-change-this-in-production-ebs-2026-xyz123
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_ENGINE=sqlite
JWT_ACCESS_TOKEN_MINUTES=20
JWT_REFRESH_TOKEN_DAYS=7

MAX_UPLOAD_SIZE_MB=5000
DATA_COMPRESSION=gzip

# ⚠️ No default ADMIN password — set via setup wizard
# ADMIN_USERNAME=ADMIN
# ADMIN_PASSWORD=            ← REMOVED (security)
# CONSULTANT_USERNAME=CONSULTANT
# CONSULTANT_PASSWORD=ORACLE123
# USER_USERNAME=USER
# USER_PASSWORD=USER123

EBS_SESSION_TTL=1200
EBS_MAX_CONNECTIONS_PER_USER=5
EBS_QUERY_TIMEOUT=300
EBS_MAX_ROWS=50000
# Oracle Instant Client path (for Thick Mode — required for Oracle 10G password verifier)
ORACLE_CLIENT_DIR=C:\Oracle\instantclient_23_26